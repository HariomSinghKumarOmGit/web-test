{
  "name": "walkaroo-site",
  "version": "1.0.0",
  "description": "Walkaroo E-commerce Website with Supabase Database, SQL Migrations & Full Asset Mirror",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server.js",
    "dev": "node server.js",
    "extract-data": "python3 scripts/extract_data.py && python3 scripts/generate_sql.py",
    "upload-supabase": "node scripts/upload_to_supabase.js",
    "upload-images": "node scripts/upload_images_to_supabase.js",
    "upload-images-preview": "node scripts/upload_images_to_supabase.js --preview"
  },
  "keywords": [
    "walkaroo",
    "ecommerce",
    "supabase",
    "sql",
    "animations",
    "motion"
  ],
  "author": "Hariom",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7"
  }
}
